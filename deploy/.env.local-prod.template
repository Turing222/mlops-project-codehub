# Local production rehearsal template
# Consumed by `make deploy-local-prod-*` through DEPLOY_ENV_FILE.
# Do not use on EC2 — copy deploy/.env.ec2.template to deploy/.env.ec2 instead.
# Secret values load from secrets/local-prod, not this env file.

# ── Image references ───────────────────────────────────────────
# Required — set via Makefile defaults (git-describe tags) or override on CLI.
#   make release-image-env IMAGE_TAG="$(git describe --tags --always --abbrev=12)"
DOCKER_IMAGE_NAME_WEB=
DOCKER_IMAGE_NAME_AI=
DOCKER_IMAGE_NAME_FRONTEND=

# ── Deploy verification ───────────────────────────────────────
# Frontend fallback on :8080 proxies /api/ to the backend (same-origin rehearsal).
DEPLOY_BASE_URL=http://localhost:8080
DEPLOY_FRONTEND_BASE_URL=http://localhost:8080
DEPLOY_ENABLE_BIFROST=true
DEPLOY_ENABLE_FRONTEND_FALLBACK=true
DEPLOY_CHECK_FRONTEND_HEALTH=true
DEPLOY_PULL_IMAGES=false
DEPLOY_LOG_TAIL=200
DEPLOY_SECRET_DIR=secrets/local-prod
DEPLOY_CW_LOG_GROUP=/dewflow/prod
DEPLOY_AWS_REGION=us-east-1
DEPLOY_CW_LOG_STREAM_PREFIX=dewflow
DEPLOY_CW_METRIC_NAMESPACE=Dewflow/Logs
DEPLOY_ALERTS_SNS_TOPIC_NAME=dewflow-prod-alerts
DEPLOY_CW_ALARM_PERIOD_SECONDS=300

# ── Core app/runtime ──────────────────────────────────────────
APP_ENV=prod
GOOGLE_OAUTH_ENABLED=false
BACKEND_LOG_LEVEL=info
BIFROST_LOG_LEVEL=info

# ── Database / Redis ──────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_DB=postgres
# Compose postgres service (deploy/docker-compose.local-postgres.yml overlay).
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_ROOT_CERT_FILE=
REDIS_HOST=redis-cache
REDIS_PORT=6379
TASKIQ_REDIS_HOST=redis-taskiq
TASKIQ_REDIS_PORT=6379
TASKIQ_RESULT_TTL_SECONDS=3600

# ── Storage (MinIO via deploy/docker-compose.local-s3.yml) ───
STORAGE_BACKEND=s3
S3_BUCKET=dewflow-local-prod
S3_PREFIX=knowledge_files
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# ── LLM / Embedding ───────────────────────────────────────────
LLM_PROVIDER=bifrost_pro
RAG_EMBED_PROVIDER=bifrost_embedding
RAG_EMBED_BATCH_SIZE=10
RAG_PLANNER_PROVIDER=bifrost_flash

# ── Feature / rate limits ─────────────────────────────────────
AUTH_REGISTER_RATE_LIMIT_TIMES=100
AUTH_LOGIN_RATE_LIMIT_TIMES=20
AUTH_SMS_LOGIN_RATE_LIMIT_TIMES=10
AUTH_GOOGLE_CALLBACK_RATE_LIMIT_TIMES=10
SMS_VERIFY_FAILURE_LIMIT=5
SMS_VERIFY_FAILURE_WINDOW_SECONDS=300
SMS_VERIFY_LOCKOUT_SECONDS=600
EDGE_NETWORK_SUBNET=172.30.0.0/24
API_NGINX_BIND=127.0.0.1
API_NGINX_PORT=8081
API_NGINX_PROXY_IP=172.30.0.11
FRONTEND_PROXY_IP=172.30.0.10
RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.30.0.11/32
BUSINESS_RATE_LIMIT_TIMES=100
CHAT_RATE_LIMIT_TIMES=10
FRONTEND_TELEMETRY_RATE_LIMIT_TIMES=300
CSP_REPORT_RATE_LIMIT_TIMES=300
