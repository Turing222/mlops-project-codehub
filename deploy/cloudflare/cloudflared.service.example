# systemd unit for cloudflared on EC2.
#
# Install (adjust paths to match your host):
#   sudo cp deploy/cloudflare/cloudflared.config.yml.example /etc/cloudflared/config.yml
#   sudo cp deploy/cloudflare/cloudflared.service.example /etc/systemd/system/cloudflared.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cloudflared
#
# Credentials must live at the path declared in config.yml (not in Git).

[Unit]
Description=Cloudflare Tunnel for Dewflow API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --config /etc/cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
