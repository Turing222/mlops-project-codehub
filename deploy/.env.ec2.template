# EC2 manual deployment template
# Copy this file to deploy/.env.ec2 on the target host and fill in the real values.
# This file is consumed by deploy/docker-compose.yml through DEPLOY_ENV_FILE.
# Secret values are loaded from EC2-only files under secrets/ec2, not this env file.
#
# Split-origin production (Cloudflare Pages + Tunnel + EC2):
#   - Domain alignment: deploy/domains.env.example
#   - Step-by-step validation: deploy/CHECKLIST.md
#   - Tunnel ingress template: deploy/cloudflare/cloudflared.config.yml.example
#   - Orchestration: make deploy-bootstrap-prod ARGS=ec2-stack
#
# When frontend is on Pages, after public URLs exist set at least:
#   DEPLOY_BASE_URL=https://api.<domain>
#   DEPLOY_FRONTEND_BASE_URL=https://app.<domain>
#   BACKEND_CORS_ORIGINS=https://app.<domain>
# If Pages Preview also calls this API, add each Preview origin to BACKEND_CORS_ORIGINS
# (see deploy/CHECKLIST.md Phase 4 strategies A/B). Pages Production must set
# VITE_API_BASE_URL to the API origin; Preview needs its own value if not using production API.

# ── Image references ───────────────────────────────────────────
# Required — the active deploy image record. Set immutable git-describe tags
# before deploying; leaving them empty makes `make deploy-ec2-check` fail by
# design (there is no 2.0.0 fallback). Get the values with:
#   make release-image-env IMAGE_TAG="$(git describe --tags --always --abbrev=12)"
DOCKER_IMAGE_NAME_WEB=
DOCKER_IMAGE_NAME_AI=
# If production frontend is on Cloudflare Pages, this image is mainly for local rehearsal / rollback.
DOCKER_IMAGE_NAME_FRONTEND=

# ── Deploy verification ───────────────────────────────────────
# DEPLOY_BASE_URL drives backend/API verification.
# If frontend is served by Cloudflare Pages, set DEPLOY_BASE_URL to the public API origin
# and DEPLOY_FRONTEND_BASE_URL to the public frontend origin.
# For single-host compose verification on the EC2 host, use the loopback API Nginx port.
DEPLOY_BASE_URL=http://127.0.0.1:8081
DEPLOY_FRONTEND_BASE_URL=http://localhost
DEPLOY_ENABLE_BIFROST=false
DEPLOY_ENABLE_FRONTEND_FALLBACK=false
DEPLOY_CHECK_FRONTEND_HEALTH=false
DEPLOY_PULL_IMAGES=false
DEPLOY_LOG_TAIL=200
# Reversible default: files uses secrets/ec2. After Secrets Manager has been
# validated on the host, set source=aws and use the ephemeral absolute path.
DEPLOY_SECRET_SOURCE=files
DEPLOY_SECRET_DIR=secrets/ec2
# DEPLOY_SECRET_SOURCE=aws
# DEPLOY_SECRET_DIR=/run/dewflow-secrets
DEPLOY_RUNTIME_SECRET_ID=dewflow-prod-runtime
DEPLOY_CW_LOG_GROUP=/dewflow/prod
DEPLOY_AWS_REGION=us-west-2
DEPLOY_CW_LOG_STREAM_PREFIX=dewflow
DEPLOY_CW_METRIC_NAMESPACE=Dewflow/Logs
DEPLOY_ALERTS_SNS_TOPIC_NAME=dewflow-prod-alerts
# DEPLOY_ALERTS_SNS_TOPIC_ARN=
# DEPLOY_ALERTS_SNS_EMAIL=alerts@example.com
DEPLOY_CW_ALARM_PERIOD_SECONDS=300
DEPLOY_CW_API_LATENCY_THRESHOLD_MS=2000
DEPLOY_CW_QUEUE_DEPTH_THRESHOLD=100
DEPLOY_CW_OLDEST_PENDING_THRESHOLD_SECONDS=300
DEPLOY_CW_QUEUE_EVALUATION_PERIODS=2
# DEPLOY_CW_VERIFY_POLL_ATTEMPTS=24
# DEPLOY_CW_VERIFY_POLL_SECONDS=10

# ── Core app/runtime ──────────────────────────────────────────
APP_ENV=prod
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# If frontend is on Cloudflare Pages, redirect URIs must point to the frontend origin.
# GOOGLE_ALLOWED_REDIRECT_URIS=https://app.example.com/auth/google/callback
# BACKEND_CORS_ORIGINS=https://app.example.com,https://preview.example.pages.dev
BACKEND_LOG_LEVEL=info
BIFROST_LOG_LEVEL=info

# ── Database / Redis ──────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_DB=postgres
# Production deploy expects RDS or another external Postgres endpoint.
# For self-hosted fallback, set POSTGRES_SERVER=postgres and add
# DEPLOY_EXTRA_COMPOSE_FILES=deploy/docker-compose.local-postgres.yml.
POSTGRES_SERVER=change-me-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
# The backend images include the public AWS RDS global CA bundle at this path.
POSTGRES_SSL_MODE=verify-full
POSTGRES_SSL_ROOT_CERT_FILE=/app/certs/rds-global-bundle.pem
REDIS_HOST=redis-cache
REDIS_PORT=6379
TASKIQ_REDIS_HOST=redis-taskiq
TASKIQ_REDIS_PORT=6379
TASKIQ_RESULT_TTL_SECONDS=3600

# ── Storage (S3 on AWS preferred) ─────────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET=change-me-bucket
S3_PREFIX=knowledge_files
S3_REGION=us-west-2
# Keep these empty on EC2 when using an instance role / default credential chain.
S3_ENDPOINT_URL=

# ── LLM / Embedding ───────────────────────────────────────────
# Mock defaults make the first manual deployment easier to verify.
# Replace with real providers and secrets later if needed.
# Set DEPLOY_ENABLE_BIFROST=true, or use a bifrost* provider, to start the
# optional Bifrost gateway profile.
LLM_PROVIDER=mock
RAG_EMBED_PROVIDER=mock
RAG_EMBED_BATCH_SIZE=10
# RAG planner / rerank exposure is controlled by GrowthBook flags
# (`enable-rag-planner`, `enable-rag-rerank`), not `RAG_*_ENABLED` env vars.
# Provider availability is still controlled by `RAG_PLANNER_PROVIDER` /
# `RAG_RERANK_PROVIDER` from app config or explicit env overrides.
# Optional circuit-breaker tuning (defaults 5 failures / 30s cooldown; scale
# thresholds up when running multiple worker processes per host):
# RAG_RERANK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# RAG_RERANK_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# EXTERNAL_CONTEXT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# EXTERNAL_CONTEXT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# GROWTHBOOK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# GROWTHBOOK_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ── Feature / rate limits ─────────────────────────────────────
# Closed-beta login: comma-separated allowlists (must match bootstrap user email/phone).
# BETA_USER_EMAIL_WHITELIST=you@example.com
# BETA_USER_PHONE_WHITELIST=
AUTH_REGISTER_RATE_LIMIT_TIMES=100
AUTH_LOGIN_RATE_LIMIT_TIMES=20
AUTH_SMS_LOGIN_RATE_LIMIT_TIMES=10
AUTH_GOOGLE_CALLBACK_RATE_LIMIT_TIMES=10
SMS_VERIFY_FAILURE_LIMIT=5
SMS_VERIFY_FAILURE_WINDOW_SECONDS=300
SMS_VERIFY_LOCKOUT_SECONDS=600
EDGE_NETWORK_SUBNET=172.30.0.0/24
# Keep api-nginx loopback-only unless another trusted edge terminates client IP.
# If exposed directly, clients can spoof CF-Connecting-IP and bypass IP limits.
API_NGINX_BIND=127.0.0.1
API_NGINX_PORT=8081
API_NGINX_PROXY_IP=172.30.0.11
FRONTEND_PROXY_IP=172.30.0.10
# Trust only the compose api-nginx address that writes X-Real-IP.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.30.0.11/32
BUSINESS_RATE_LIMIT_TIMES=100
CHAT_RATE_LIMIT_TIMES=10
FRONTEND_TELEMETRY_RATE_LIMIT_TIMES=300
CSP_REPORT_RATE_LIMIT_TIMES=300

# ── Secret file paths ─────────────────────────────────────────
# Required files are generated by `make deploy-ec2-secrets-prepare` if absent:
#   secrets/ec2/secret_key.txt
#   secrets/ec2/postgres_password.txt
#   secrets/ec2/redis_password.txt
# Optional integration secret files are auto-touched as empty files.
# Override individual DEPLOY_*_FILE variables only if you store secrets elsewhere.
