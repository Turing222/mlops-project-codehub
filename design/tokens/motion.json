{
  "$description": "Motion tokens. Figma annotates these as notes; implementation is CSS / engine-specific.",
  "duration": {
    "micro": { "$type": "duration", "$value": "150ms" },
    "fast": { "$type": "duration", "$value": "200ms" },
    "standard": { "$type": "duration", "$value": "250ms" },
    "enter": { "$type": "duration", "$value": "300ms" },
    "page": { "$type": "duration", "$value": "400ms" }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.4, 0, 0.2, 1],
      "$description": "Material standard; hover, overlay"
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": [0.16, 1, 0.3, 1],
      "$description": "Page and message fade-in"
    },
    "emphasis": {
      "$type": "cubicBezier",
      "$value": [0.34, 1.56, 0.64, 1],
      "$description": "Modal zoom only"
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1],
      "$description": "Spinners, coin rotate"
    }
  },
  "preset": {
    "message-enter": {
      "duration": "duration.enter",
      "easing": "ease-out",
      "from": { "opacity": 0, "translateY": "8px" },
      "to": { "opacity": 1, "translateY": "0" }
    },
    "page-enter": {
      "duration": "duration.page",
      "easing": "easing.enter"
    },
    "modal-overlay": {
      "duration": "duration.standard",
      "easing": "easing.standard"
    },
    "modal-zoom": {
      "duration": "duration.enter",
      "easing": "easing.emphasis"
    },
    "thinking-dot": {
      "duration": "1400ms",
      "easing": "ease-in-out",
      "stagger": "160ms"
    }
  }
}
