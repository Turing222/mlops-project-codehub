{
  "$description": "Layout constants. Product-specific max-widths and chrome heights.",
  "layout": {
    "chat": {
      "header-height": { "$type": "dimension", "$value": "56px" },
      "content-max-width": { "$type": "dimension", "$value": "800px" },
      "avatar-size": { "$type": "dimension", "$value": "36px" },
      "assistant-avatar-size": { "$type": "dimension", "$value": "42px" },
      "sidebar-expanded": { "$type": "dimension", "$value": "260px" },
      "sidebar-collapsed": { "$type": "dimension", "$value": "64px" }
    },
    "admin": {
      "header-height": { "$type": "dimension", "$value": "56px" },
      "content-max-width": { "$type": "dimension", "$value": "1600px" },
      "card-radius": { "$type": "dimension", "$value": "12px" }
    },
    "modal": {
      "profile-width": { "$type": "dimension", "$value": "720px" },
      "profile-height": { "$type": "dimension", "$value": "520px" },
      "sidebar-width": { "$type": "dimension", "$value": "200px" }
    }
  },
  "shadow": {
    "bubble": {
      "$type": "shadow",
      "$value": { "offsetX": "0", "offsetY": "1px", "blur": "2px", "color": "rgba(0,0,0,0.04)" }
    },
    "card": {
      "$type": "shadow",
      "$value": { "offsetX": "0", "offsetY": "1px", "blur": "3px", "color": "rgba(0,0,0,0.06)" }
    },
    "modal": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "24px",
        "blur": "64px",
        "color": "rgba(0,0,0,0.25)"
      }
    }
  }
}
