{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-pages-headers.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run test:e2e:mock",
    "test:e2e:mock": "playwright test --project=mock -c e2e/playwright.config.ts",
    "test:e2e:smoke": "E2E_SMOKE=1 playwright test --project=smoke -c e2e/playwright.config.ts",
    "test:e2e:screens": "playwright test --project=screens -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --project=mock -c e2e/playwright.config.ts --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "antd": "^6.2.3",
    "axios": "^1.18.1",
    "i18next": "^24.2.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.18.2",
    "web-vitals": "^5.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "msw": "^2.14.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
