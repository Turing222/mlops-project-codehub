# Python 忽略项
__pycache__/
*.pyc
venv/
.venv/
.mypy_cache/
.pytest_cache/

# 编辑器/IDE 忽略项
.vscode/

# Docker 忽略项
*.o
*.so
.DS_Store

# 测试数据
data/

#mlflow的本地数据存储
mlruns/
mlartifacts/

# 忽略所有的环境配置文件
.env
.env.smoke
key.env
*.env
deploy/.env.ec2

# 忽略 Jupyter 的检查点备份
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/
*-checkpoint.ipynb

#忽略postgres数据文件
postgres_data/

#chainlit
.chainlit/

#前端
.frontend/
frontend/node_modules/
frontend/apps/*/node_modules/
frontend/apps/*/dist/
frontend/apps/*/dist-ssr/
frontend/apps/*/coverage/

# 数据与日志 (非常重要，防止镜像过大)
logs/*
postgres_logs/
postgres_data/
redis_data/
*.log
.logs/

#密钥 & SSL 证书（私钥绝不能入库）
deploy/nginx/ssl/
deploy/k8s/local-scaling/secret.local.yaml
secrets/smoke/*
!secrets/smoke/README.md
!secrets/smoke/.gitkeep
#本地测试
tests/test_demo.py
.traces/
#历史数据库更新版本
alembic/archive_versions
test_demo.py
.antigravityignore
.codex/*
!.codex/skills/
!.codex/skills/**
.cache/

# 测试快照归档（不提交到仓库）
snapshots/*.json
perf/reports/

# 覆盖率报告（构建产物，不提交）
htmlcov/
.coverage
.coverage.*
# 工具目录
tools/
test-debug-agent/
.claude/plans/*
